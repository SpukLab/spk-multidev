# Proveedores de IA
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub (fallback compartido — cada usuario puede cargar el suyo en
# Configuración > Mis API keys, requiere scope delete_repo si se usa limpieza)
GITHUB_TOKEN=

# Auth propia delante del hub (sección 11 de CONTEXT_BASE.md)
HUB_ACCESS_PASSWORD=

# Persistencia (Supabase Postgres) — sección 11
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Key pública (anon) — necesaria para que el browser se suscriba a
# Supabase Realtime directamente (sección 20). Es segura de exponer:
# las políticas RLS ya restringen a lectura pública en las tablas que la usan.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenHands (tareas asíncronas de repo, sección 20)
# URL del Agent Server self-hosteado (ej: http://tu-tunnel.trycloudflare.com)
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=
# Modelo por defecto a usar al lanzar tareas (con prefijo openai/ requerido
# por LiteLLM para endpoints compatibles con OpenAI, ej NVIDIA NIM)
OPENHANDS_LLM_MODEL=openai/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Secreto compartido: valida tanto el relay local (scripts/openhands-relay.js)
# como cualquier llamada al webhook. El relay corre en tu PC, no acá.
OPENHANDS_WEBHOOK_SECRET=
